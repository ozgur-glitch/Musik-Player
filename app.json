{
  "expo": {
    "name": "Musik Player",
    "slug": "musik-player",
    "version": "1.0.8",
    "orientation": "portrait",
    "icon": "./icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#121212"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.oc2003.musikplayer"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./icon.png",
        "backgroundColor": "#121212"
      },
      "package": "com.oc2003.musikplayer",
      "permissions": [
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "WAKE_LOCK",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "MEDIA_CONTENT_CONTROL"
      ]
    },
    "owner": "ozce",
    "extra": {
      "eas": {
        "projectId": "dbbbb9a6-de42-4470-83a9-09a22a9bbafd"
      }
    }
  }
}
